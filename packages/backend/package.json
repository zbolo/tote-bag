{
  "name": "@tote-bag/backend",
  "version": "1.0.0",
  "description": "Backend API for Tote Bag grocery shopping assistant",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "migrate:up": "node -r tsx/cjs dist/migrations/migrate.js up",
    "migrate:down": "node -r tsx/cjs dist/migrations/migrate.js down",
    "migrate:create": "mikro-orm migration:create"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.3.0",
    "@mikro-orm/postgresql": "^6.3.0",
    "@mikro-orm/reflection": "^6.3.0",
    "@mikro-orm/migrations": "^6.3.0",
    "express": "^4.18.2",
    "supertokens-node": "^18.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "zod": "^3.23.8",
    "axios": "^1.7.2",
    "uuid": "^10.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.3.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "supertest": "^7.0.0"
  }
}
