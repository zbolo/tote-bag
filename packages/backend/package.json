{
  "name": "@tote-bag/backend",
  "version": "1.0.0",
  "description": "Backend API for Tote Bag grocery shopping assistant",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "migrate:up": "node -r tsx/cjs dist/migrations/migrate.js up",
    "migrate:down": "node -r tsx/cjs dist/migrations/migrate.js down",
    "migrate:create": "mikro-orm migration:create"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.3.12",
    "@mikro-orm/postgresql": "^6.3.12",
    "@mikro-orm/reflection": "^6.3.12",
    "@mikro-orm/migrations": "^6.3.12",
    "express": "^4.21.1",
    "supertokens-node": "^20.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "zod": "^3.23.8",
    "axios": "^1.7.9",
    "uuid": "^11.0.3",
    "compression": "^1.7.5",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.3.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "supertest": "^7.0.0"
  }
}
