{
  "name": "@tote-bag/backend",
  "version": "0.1.7",
  "description": "Backend API for Tote Bag grocery shopping assistant - Plain JavaScript with JSDoc",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "migrate:create": "mikro-orm migration:create"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.3.12",
    "@mikro-orm/postgresql": "^6.3.12",
    "@mikro-orm/migrations": "^6.3.12",
    "express": "^4.21.1",
    "supertokens-node": "^20.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "zod": "^3.23.8",
    "axios": "^1.7.9",
    "uuid": "^11.0.3",
    "compression": "^1.7.5",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.3.12",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
